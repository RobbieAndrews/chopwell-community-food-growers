---
import {BookOpenText, ChefHat} from '@lucide/astro';
import {PortableText} from 'astro-portabletext';

import BackLink from '../../components/BackLink.astro';
import ContentSection from '../../components/ContentSection.astro';
import SanityImage from '../../components/SanityImage.astro';
import RecipeDetailPanel from '../../components/recipes/RecipeDetailPanel';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  articlePortableTextComponents,
} from '../../lib/articlePortableText';
import {fetchRecipePage, fetchRecipeSlugs} from '../../lib/recipePageData';
import {
  getRecipeCategoryTitle,
  getRecipeDifficultyTitle,
} from '../../lib/recipes';

export async function getStaticPaths(): Promise<{params: {slug: string}}[]> {
  return await fetchRecipeSlugs();
}
const recipe = await fetchRecipePage(Astro.params.slug ?? '');

if (!recipe) {
  return Astro.redirect('/recipes');
}

const categoryLabel = getRecipeCategoryTitle(recipe.category);
const difficultyLabel = recipe.difficulty ? getRecipeDifficultyTitle(recipe.difficulty) : null;
const printHref = `/recipes/print/${recipe.slug.current}`;
---

<SiteLayout title={recipe.title}>
  <ContentSection size="narrow" spacing="stack" class="bg-white/70" innerClass="section-stack">
    <BackLink href="/recipes" label="Back to recipes" />

    <section>
      <div class="flex flex-col justify-center pb-2 sm:pb-4">
        <div class="flex flex-wrap gap-2">
          <span class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold tracking-[0.12em] uppercase text-rose-700">
            {categoryLabel}
          </span>
          {
            difficultyLabel ? (
              <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold tracking-[0.12em] uppercase text-amber-900">
                {difficultyLabel}
              </span>
            ) : null
          }
        </div>

        <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
          {recipe.title}
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-gray-600">{recipe.excerpt}</p>

      </div>

      <div class="w-full">
        {
          recipe.heroImage ? (
            <SanityImage
              image={recipe.heroImage}
              alt={recipe.heroImage.alt || recipe.title}
              preset="contentHero"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-1280/822 h-full min-h-72 max-h-96 w-full object-cover"
            />
          ) : (
            <div class="flex h-full min-h-72 items-center justify-center bg-[linear-gradient(135deg,#f4ebe0_0%,#f8f5ee_48%,#dceccb_100%)] text-[#17324c]">
              <ChefHat class="h-16 w-16" />
            </div>
          )
        }
      </div>

      <article class="my-3 border-t border-gray-200/80 py-3 sm:my-5 sm:py-5">
        {
          Array.isArray(recipe.introContent) && recipe.introContent.length ? (
            <section class="mt-2 sm:rounded-[1.75rem] sm:bg-[var(--ccfg-cream)]/85 sm:p-6">
              <div class="flex items-center gap-3 text-[#17324c]">
                <BookOpenText class="h-6 w-6" />
                <h2 class="text-2xl font-semibold text-gray-900">Before you start</h2>
              </div>

              <div class="portable-content mt-5 border-t border-[#17324c]/10 pt-5 sm:border-t-0 sm:pt-0">
                <PortableText value={recipe.introContent} components={articlePortableTextComponents} />
              </div>
            </section>
          ) : null
        }

        <section class="mt-8">
          <RecipeDetailPanel
            client:load
            printHref={printHref}
            servings={recipe.servings}
            prepTime={recipe.prepTime}
            cookTime={recipe.cookTime}
            ingredientSections={recipe.ingredientSections ?? []}
            instructionSections={recipe.instructionSections ?? []}
          />
        </section>

        {
          Array.isArray(recipe.recipeNotes) && recipe.recipeNotes.length ? (
            <section class="mt-10 rounded-[1.75rem] bg-amber-50/75 p-5 sm:mt-12 sm:p-6">
              <h2 class="text-3xl font-semibold text-[#f77663]">Recipe Notes</h2>
              <div class="portable-content mt-5 border-t border-[#17324c]/10 pt-5 sm:border-t-0 sm:pt-0">
                <PortableText value={recipe.recipeNotes} components={articlePortableTextComponents} />
              </div>
            </section>
          ) : null
        }
      </article>
    </section>
  </ContentSection>
</SiteLayout>
