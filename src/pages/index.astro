---
import SiteLayout from "../layouts/SiteLayout.astro";
import Container from "../components/Container.astro";
import FullBleedSection from "../components/FullBleedSection.astro";
import {
    ArrowRight,
    CalendarDays,
    Leaf,
    Sprout,
} from "@lucide/astro";
import { sanityClient } from "sanity:client";
import { urlForImage, type SanityImageWithAlt } from "../lib/sanity";

type HomePagePathwayIcon = "calendar" | "leaf" | "sprout";
type GalleryLayoutVariant = "standard" | "tall" | "wide";

interface HomePageLink {
    label?: string;
    href?: string;
}

interface HomePagePathwayItem {
    _key?: string;
    title?: string;
    description?: string;
    href?: string;
    linkLabel?: string;
    image?: SanityImageWithAlt;
    icon?: HomePagePathwayIcon;
}

interface HomePageSeasonalMoment {
    _key?: string;
    title?: string;
    copy?: string;
}

interface HomePageGalleryItem {
    _key?: string;
    title?: string;
    image?: SanityImageWithAlt;
    layoutVariant?: GalleryLayoutVariant;
}

interface HomePageDocument {
    hero?: {
        heading?: string;
        intro?: string;
        primaryCta?: HomePageLink;
        secondaryCta?: HomePageLink;
        primaryImage?: SanityImageWithAlt;
        secondaryImage?: SanityImageWithAlt;
        tertiaryImage?: SanityImageWithAlt;
    };
    pathwaysSection?: {
        eyebrow?: string;
        heading?: string;
        intro?: string;
        items?: HomePagePathwayItem[];
    };
    seasonalSection?: {
        eyebrow?: string;
        heading?: string;
        intro?: string;
        featureImage?: SanityImageWithAlt;
        calloutLabel?: string;
        calloutCopy?: string;
        moments?: HomePageSeasonalMoment[];
        primaryCta?: HomePageLink;
        secondaryCta?: HomePageLink;
    };
    gallerySection?: {
        eyebrow?: string;
        heading?: string;
        intro?: string;
        items?: HomePageGalleryItem[];
    };
    finalCtaSection?: {
        eyebrow?: string;
        heading?: string;
        body?: string;
        backgroundImage?: SanityImageWithAlt;
        primaryCta?: HomePageLink;
        secondaryCta?: HomePageLink;
    };
}

const HOME_PAGE_QUERY = `*[
    _type == "homePage"
]|order(_updatedAt desc)[0]{
    hero{
        heading,
        intro,
        primaryCta{label, href},
        secondaryCta{label, href},
        primaryImage,
        secondaryImage,
        tertiaryImage
    },
    pathwaysSection{
        eyebrow,
        heading,
        intro,
        items[]{
            _key,
            title,
            description,
            href,
            linkLabel,
            image,
            icon
        }
    },
    seasonalSection{
        eyebrow,
        heading,
        intro,
        featureImage,
        calloutLabel,
        calloutCopy,
        moments[]{
            _key,
            title,
            copy
        },
        primaryCta{label, href},
        secondaryCta{label, href}
    },
    gallerySection{
        eyebrow,
        heading,
        intro,
        items[]{
            _key,
            title,
            image,
            layoutVariant
        }
    },
    finalCtaSection{
        eyebrow,
        heading,
        body,
        backgroundImage,
        primaryCta{label, href},
        secondaryCta{label, href}
    }
}`;

const homePage = await sanityClient.fetch<HomePageDocument | null>(
    HOME_PAGE_QUERY,
);

const iconMap = {
    sprout: Sprout,
    calendar: CalendarDays,
    leaf: Leaf,
} as const;

const galleryHeightClassMap: Record<GalleryLayoutVariant, string> = {
    tall: "md:row-span-2 md:min-h-[32rem]",
    standard: "md:min-h-[15rem]",
    wide: "md:col-span-2 md:min-h-[18rem]",
};

function getImageData(
    image: SanityImageWithAlt | undefined,
    size: { width: number; height: number },
) {
    if (!image?.alt) return null;

    const src = urlForImage(image)
        ?.width(size.width)
        .height(size.height)
        .fit("crop")
        .auto("format")
        .url();

    if (!src) return null;

    return {
        src,
        alt: image.alt,
    };
}

function isValidLink(link: HomePageLink | undefined) {
    return Boolean(link?.label && link?.href);
}

function hasText(value: string | undefined) {
    return Boolean(value?.trim());
}

const heroPrimaryImage = getImageData(homePage?.hero?.primaryImage, {
    width: 1400,
    height: 1600,
});
const heroSecondaryImage = getImageData(homePage?.hero?.secondaryImage, {
    width: 1200,
    height: 900,
});
const heroTertiaryImage = getImageData(homePage?.hero?.tertiaryImage, {
    width: 1200,
    height: 900,
});
const seasonalFeatureImage = getImageData(
    homePage?.seasonalSection?.featureImage,
    {
        width: 1600,
        height: 1200,
    },
);
const finalCtaImage = getImageData(homePage?.finalCtaSection?.backgroundImage, {
    width: 1600,
    height: 900,
});

const pathways =
    homePage?.pathwaysSection?.items
        ?.filter(
            (item): item is Required<
                Pick<
                    HomePagePathwayItem,
                    "title" | "description" | "href" | "linkLabel" | "icon"
                >
            > &
                HomePagePathwayItem =>
                Boolean(
                    item?.title &&
                        item?.description &&
                        item?.href &&
                        item?.linkLabel &&
                        item?.icon &&
                        item.icon in iconMap,
                ),
        )
        .map((item) => {
            const image = getImageData(item.image, {
                width: 1200,
                height: 1400,
            });

            return {
                title: item.title,
                description: item.description,
                href: item.href,
                linkLabel: item.linkLabel,
                image: image?.src ?? null,
                icon: item.icon,
            };
        })
        .filter((item): item is NonNullable<typeof item> => Boolean(item)) ?? [];

const seasonalMoments =
    homePage?.seasonalSection?.moments
        ?.filter(
            (item): item is Required<HomePageSeasonalMoment> =>
                Boolean(item?.title && item?.copy),
        )
        .map((item) => ({
            title: item.title,
            copy: item.copy,
        })) ?? [];

const galleryItems =
    homePage?.gallerySection?.items
        ?.filter(
            (item): item is Required<
                Pick<HomePageGalleryItem, "title" | "layoutVariant" | "image">
            > &
                HomePageGalleryItem =>
                Boolean(
                    item?.title &&
                        item?.image?.alt &&
                        item?.layoutVariant &&
                        item.layoutVariant in galleryHeightClassMap,
                ),
        )
        .map((item) => {
            const image = getImageData(item.image, {
                width: 1200,
                height: 1200,
            });

            if (!image) return null;

            return {
                title: item.title,
                src: image.src,
                alt: image.alt,
                heightClass: galleryHeightClassMap[item.layoutVariant],
            };
        })
        .filter((item): item is NonNullable<typeof item> => Boolean(item)) ?? [];

const heroSection = homePage?.hero &&
    (
        hasText(homePage.hero.heading) ||
        hasText(homePage.hero.intro) ||
        isValidLink(homePage.hero.primaryCta) ||
        isValidLink(homePage.hero.secondaryCta) ||
        heroPrimaryImage ||
        heroSecondaryImage ||
        heroTertiaryImage
    )
        ? {
              heading: homePage.hero.heading,
              intro: homePage.hero.intro,
              primaryCta: isValidLink(homePage.hero.primaryCta)
                  ? homePage.hero.primaryCta
                  : null,
              secondaryCta: isValidLink(homePage.hero.secondaryCta)
                  ? homePage.hero.secondaryCta
                  : null,
              primaryImage: heroPrimaryImage,
              secondaryImage: heroSecondaryImage,
              tertiaryImage: heroTertiaryImage,
          }
        : null;

const pathwaysSection = homePage?.pathwaysSection &&
    (
        hasText(homePage.pathwaysSection.eyebrow) ||
        hasText(homePage.pathwaysSection.heading) ||
        hasText(homePage.pathwaysSection.intro) ||
        pathways.length > 0
    )
        ? {
              eyebrow: homePage.pathwaysSection.eyebrow,
              heading: homePage.pathwaysSection.heading,
              intro: homePage.pathwaysSection.intro,
              items: pathways,
          }
        : null;

const seasonalSection = homePage?.seasonalSection &&
    (
        hasText(homePage.seasonalSection.eyebrow) ||
        hasText(homePage.seasonalSection.heading) ||
        hasText(homePage.seasonalSection.intro) ||
        hasText(homePage.seasonalSection.calloutLabel) ||
        hasText(homePage.seasonalSection.calloutCopy) ||
        isValidLink(homePage.seasonalSection.primaryCta) ||
        isValidLink(homePage.seasonalSection.secondaryCta) ||
        seasonalFeatureImage ||
        seasonalMoments.length > 0
    )
        ? {
              eyebrow: homePage.seasonalSection.eyebrow,
              heading: homePage.seasonalSection.heading,
              intro: homePage.seasonalSection.intro,
              calloutLabel: homePage.seasonalSection.calloutLabel,
              calloutCopy: homePage.seasonalSection.calloutCopy,
              primaryCta: isValidLink(homePage.seasonalSection.primaryCta)
                  ? homePage.seasonalSection.primaryCta
                  : null,
              secondaryCta: isValidLink(homePage.seasonalSection.secondaryCta)
                  ? homePage.seasonalSection.secondaryCta
                  : null,
              featureImage: seasonalFeatureImage,
              moments: seasonalMoments,
          }
        : null;

const gallerySection = homePage?.gallerySection &&
    (
        hasText(homePage.gallerySection.eyebrow) ||
        hasText(homePage.gallerySection.heading) ||
        hasText(homePage.gallerySection.intro) ||
        galleryItems.length > 0
    )
        ? {
              eyebrow: homePage.gallerySection.eyebrow,
              heading: homePage.gallerySection.heading,
              intro: homePage.gallerySection.intro,
              items: galleryItems,
          }
        : null;

const finalSection = homePage?.finalCtaSection &&
    (
        hasText(homePage.finalCtaSection.eyebrow) ||
        hasText(homePage.finalCtaSection.heading) ||
        hasText(homePage.finalCtaSection.body) ||
        isValidLink(homePage.finalCtaSection.primaryCta) ||
        isValidLink(homePage.finalCtaSection.secondaryCta) ||
        finalCtaImage
    )
        ? {
              eyebrow: homePage.finalCtaSection.eyebrow,
              heading: homePage.finalCtaSection.heading,
              body: homePage.finalCtaSection.body,
              primaryCta: isValidLink(homePage.finalCtaSection.primaryCta)
                  ? homePage.finalCtaSection.primaryCta
                  : null,
              secondaryCta: isValidLink(homePage.finalCtaSection.secondaryCta)
                  ? homePage.finalCtaSection.secondaryCta
                  : null,
              backgroundImage: finalCtaImage,
          }
        : null;
---

<SiteLayout title="Home" mainClass="px-0 py-0" wrapContent={false}>
    {
        heroSection && (
            <section
                class="relative isolate overflow-hidden bg-[linear-gradient(135deg,#19301d_0%,#26472a_48%,#c7b89a_100%)] text-white"
            >
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.18),transparent_30%),radial-gradient(circle_at_bottom_right,rgba(244,213,141,0.22),transparent_24%)]"
                >
                </div>
                <Container class="relative py-16 lg:py-24">
                    <div
                        class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-stretch"
                    >
                        <div class="space-y-8">
                            <div class="space-y-5">
                                {
                                    heroSection.heading ? (
                                        <h1
                                            class="max-w-3xl text-5xl leading-[0.92] font-semibold text-balance sm:text-6xl lg:text-7xl"
                                        >
                                            {heroSection.heading}
                                        </h1>
                                    ) : null
                                }
                                {
                                    heroSection.intro ? (
                                        <p
                                            class="max-w-2xl text-lg leading-8 text-white/78 sm:text-xl"
                                        >
                                            {heroSection.intro}
                                        </p>
                                    ) : null
                                }
                            </div>

                            {
                                heroSection.primaryCta || heroSection.secondaryCta ? (
                                    <div class="flex flex-col gap-4 sm:flex-row">
                                        {
                                            heroSection.primaryCta ? (
                                                <a
                                                    href={heroSection.primaryCta.href}
                                                    class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--ccfg-cream)] px-7 py-4 text-sm font-semibold tracking-[0.12em] uppercase text-[var(--ccfg-forest)] transition hover:-translate-y-0.5 hover:bg-white"
                                                >
                                                    <span>{heroSection.primaryCta.label}</span>
                                                    <ArrowRight class="h-4 w-4" />
                                                </a>
                                            ) : null
                                        }
                                        {
                                            heroSection.secondaryCta ? (
                                                <a
                                                    href={heroSection.secondaryCta.href}
                                                    class="inline-flex items-center justify-center rounded-full border border-white/28 px-7 py-4 text-sm font-semibold tracking-[0.12em] uppercase text-white transition hover:bg-white/10"
                                                >
                                                    {heroSection.secondaryCta.label}
                                                </a>
                                            ) : null
                                        }
                                    </div>
                                ) : null
                            }
                        </div>

                        <div class="relative min-h-[32rem] lg:min-h-0 lg:h-full lg:self-stretch">
                            <div
                                class="absolute inset-x-8 top-0 h-20 rounded-full bg-white/12 blur-3xl"
                            >
                            </div>
                            <div
                                class="grid h-full gap-4 sm:grid-cols-[1.15fr_0.85fr] sm:grid-rows-[1.2fr_0.8fr]"
                            >
                                {
                                    heroSection.primaryImage ? (
                                        <div
                                            class="overflow-hidden rounded-[2rem] shadow-2xl sm:row-span-2"
                                        >
                                            <img
                                                src={heroSection.primaryImage.src}
                                                alt={heroSection.primaryImage.alt}
                                                width="1400"
                                                height="1600"
                                                class="h-full w-full object-cover"
                                                loading="eager"
                                                decoding="async"
                                            />
                                        </div>
                                    ) : null
                                }
                                {
                                    heroSection.secondaryImage ? (
                                        <div
                                            class="overflow-hidden rounded-[1.75rem] shadow-2xl"
                                        >
                                            <img
                                                src={heroSection.secondaryImage.src}
                                                alt={heroSection.secondaryImage.alt}
                                                width="1200"
                                                height="900"
                                                class="h-full w-full object-cover"
                                                loading="eager"
                                                decoding="async"
                                            />
                                        </div>
                                    ) : null
                                }
                                {
                                    heroSection.tertiaryImage ? (
                                        <div
                                            class="overflow-hidden rounded-[1.75rem] shadow-2xl"
                                        >
                                            <img
                                                src={heroSection.tertiaryImage.src}
                                                alt={heroSection.tertiaryImage.alt}
                                                width="1200"
                                                height="900"
                                                class="h-full w-full object-cover"
                                                loading="eager"
                                                decoding="async"
                                            />
                                        </div>
                                    ) : null
                                }
                            </div>
                        </div>
                    </div>
                </Container>
            </section>
        )
    }

    {
        pathwaysSection && (
            <FullBleedSection class="py-20 lg:py-24" bleedClass="bleed-white-70">
        <div
            class="mb-10 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between"
        >
            <div class="max-w-2xl">
                {
                    pathwaysSection.eyebrow ? (
                        <p
                            class="text-sm font-semibold tracking-[0.18em] uppercase text-[var(--ccfg-moss)]"
                        >
                            {pathwaysSection.eyebrow}
                        </p>
                    ) : null
                }
                {
                    pathwaysSection.heading ? (
                        <h2
                            class="mt-3 text-4xl font-semibold text-balance text-[var(--ccfg-ink)] lg:text-5xl"
                        >
                            {pathwaysSection.heading}
                        </h2>
                    ) : null
                }
            </div>
            {
                pathwaysSection.intro ? (
                    <p class="max-w-xl text-lg leading-8 text-gray-600">
                        {pathwaysSection.intro}
                    </p>
                ) : null
            }
        </div>

        <div class="grid gap-6 lg:grid-cols-3">
            {
                pathwaysSection.items.map((item) => {
                    const Icon = iconMap[item.icon];

                    return (
                        <a
                            href={item.href}
                            class="group relative isolate flex min-h-[26rem] overflow-hidden rounded-[2rem] text-white shadow-xl"
                        >
                            {
                                item.image ? (
                                    <img
                                        src={item.image}
                                        alt={item.title}
                                        width="1200"
                                        height="1400"
                                        class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                ) : (
                                    <div class="absolute inset-0 bg-[linear-gradient(135deg,#27492a_0%,#19301d_100%)]" />
                                )
                            }
                            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(12,22,13,0.12)_0%,rgba(12,22,13,0.72)_65%,rgba(12,22,13,0.92)_100%)]" />
                            <div class="relative flex w-full flex-col justify-between p-7">
                                <div class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-white/25 bg-white/10 backdrop-blur-sm">
                                    <Icon class="h-5 w-5" />
                                </div>
                                <div>
                                    <h3 class="text-3xl font-semibold">
                                        {item.title}
                                    </h3>
                                    <p class="mt-3 max-w-sm text-base leading-7 text-white/78">
                                        {item.description}
                                    </p>
                                    <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold tracking-[0.14em] uppercase text-[var(--ccfg-sand)]">
                                        {item.linkLabel}
                                        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                                    </span>
                                </div>
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </FullBleedSection>
        )
    }

    {
        seasonalSection && (
            <section class="py-20 lg:py-24">
        <Container>
            <div
                class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]"
            >
                <div
                    class="relative overflow-hidden rounded-[2.25rem] bg-[#d8ccb4] shadow-2xl"
                >
                    {
                        seasonalSection.featureImage ? (
                            <img
                                src={seasonalSection.featureImage.src}
                                alt={seasonalSection.featureImage.alt}
                                width="1600"
                                height="1200"
                                class="h-full min-h-[30rem] w-full object-cover"
                                loading="lazy"
                                decoding="async"
                            />
                        ) : (
                            <div class="min-h-[30rem] bg-[linear-gradient(135deg,#d8ccb4_0%,#efe6d5_100%)]" />
                        )
                    }
                    {
                        seasonalSection.calloutLabel || seasonalSection.calloutCopy ? (
                            <div
                                class="absolute inset-x-6 bottom-6 rounded-[1.75rem] bg-[rgba(246,244,235,0.92)] p-5 text-[var(--ccfg-ink)] shadow-lg backdrop-blur"
                            >
                                {
                                    seasonalSection.calloutLabel ? (
                                        <p
                                            class="text-sm font-semibold tracking-[0.15em] uppercase text-[var(--ccfg-moss)]"
                                        >
                                            {seasonalSection.calloutLabel}
                                        </p>
                                    ) : null
                                }
                                {
                                    seasonalSection.calloutCopy ? (
                                        <p class="mt-2 text-base leading-7 text-gray-700">
                                            {seasonalSection.calloutCopy}
                                        </p>
                                    ) : null
                                }
                            </div>
                        ) : null
                    }
                </div>

                <div
                    class="rounded-[2.25rem] bg-white/80 p-8 shadow-xl ring-1 ring-black/5 backdrop-blur lg:p-10"
                >
                    {
                        seasonalSection.eyebrow ? (
                            <p
                                class="text-sm font-semibold tracking-[0.18em] uppercase text-[var(--ccfg-moss)]"
                            >
                                {seasonalSection.eyebrow}
                            </p>
                        ) : null
                    }
                    {
                        seasonalSection.heading ? (
                            <h2
                                class="mt-3 text-4xl font-semibold text-balance text-[var(--ccfg-ink)] lg:text-5xl"
                            >
                                {seasonalSection.heading}
                            </h2>
                        ) : null
                    }
                    {
                        seasonalSection.intro ? (
                            <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-600">
                                {seasonalSection.intro}
                            </p>
                        ) : null
                    }

                    {
                        seasonalSection.moments.length ? (
                            <div class="mt-10 space-y-5">
                                {
                                    seasonalSection.moments.map((item, index) => (
                                        <div class="grid gap-3 border-t border-[var(--ccfg-sand)]/70 pt-5 sm:grid-cols-[auto_1fr]">
                                            <div class="text-sm font-semibold tracking-[0.16em] uppercase text-[var(--ccfg-moss)]">
                                                0{index + 1}
                                            </div>
                                            <div>
                                                <h3 class="text-2xl font-semibold text-[var(--ccfg-ink)]">
                                                    {item.title}
                                                </h3>
                                                <p class="mt-2 text-base leading-7 text-gray-600">
                                                    {item.copy}
                                                </p>
                                            </div>
                                        </div>
                                    ))
                                }
                            </div>
                        ) : null
                    }

                    {
                        seasonalSection.primaryCta || seasonalSection.secondaryCta ? (
                            <div class="mt-10 flex flex-col gap-4 sm:flex-row">
                                {
                                    seasonalSection.primaryCta ? (
                                        <a
                                            href={seasonalSection.primaryCta.href}
                                            class="inline-flex items-center justify-center rounded-full bg-[var(--ccfg-forest)] px-6 py-3.5 text-sm font-semibold tracking-[0.12em] uppercase text-white transition hover:bg-[#1b331e]"
                                        >
                                            {seasonalSection.primaryCta.label}
                                        </a>
                                    ) : null
                                }
                                {
                                    seasonalSection.secondaryCta ? (
                                        <a
                                            href={seasonalSection.secondaryCta.href}
                                            class="inline-flex items-center justify-center rounded-full border border-[var(--ccfg-forest)]/18 px-6 py-3.5 text-sm font-semibold tracking-[0.12em] uppercase text-[var(--ccfg-forest)] transition hover:bg-[var(--ccfg-cream)]"
                                        >
                                            {seasonalSection.secondaryCta.label}
                                        </a>
                                    ) : null
                                }
                            </div>
                        ) : null
                    }
                </div>
            </div>
        </Container>
    </section>
        )
    }

    {
        gallerySection && (
            <FullBleedSection class="py-20 lg:py-24" bleedClass="bleed-gray-50">
        <div
            class="mb-10 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between"
        >
            <div class="max-w-2xl">
                {
                    gallerySection.eyebrow ? (
                        <p
                            class="text-sm font-semibold tracking-[0.18em] uppercase text-[var(--ccfg-moss)]"
                        >
                            {gallerySection.eyebrow}
                        </p>
                    ) : null
                }
                {
                    gallerySection.heading ? (
                        <h2
                            class="mt-3 text-4xl font-semibold text-balance text-[var(--ccfg-ink)] lg:text-5xl"
                        >
                            {gallerySection.heading}
                        </h2>
                    ) : null
                }
            </div>
            {
                gallerySection.intro ? (
                    <p class="max-w-xl text-lg leading-8 text-gray-600">
                        {gallerySection.intro}
                    </p>
                ) : null
            }
        </div>

        <div class="grid auto-rows-fr gap-5 md:grid-cols-3">
            {
                gallerySection.items.map((item) => (
                    <div
                        class:list={[
                            "group relative overflow-hidden rounded-[2rem] shadow-lg",
                            item.heightClass,
                        ]}
                    >
                        <img
                            src={item.src}
                            alt={item.alt}
                            width="1200"
                            height="1200"
                            class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            loading="lazy"
                            decoding="async"
                        />
                        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(10,18,11,0.04)_0%,rgba(10,18,11,0.7)_100%)]" />
                        <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                            <p class="text-sm font-semibold tracking-[0.14em] uppercase text-[var(--ccfg-sand)]">
                                Chopwell Community Food Growers
                            </p>
                            <h3 class="mt-2 text-2xl font-semibold">
                                {item.title}
                            </h3>
                        </div>
                    </div>
                ))
            }
        </div>
    </FullBleedSection>
        )
    }

    {
        finalSection && (
            <section class="py-20 lg:py-24">
        <Container>
            <div
                class="relative isolate overflow-hidden rounded-[2.5rem] bg-[#1d3520] text-white shadow-2xl"
            >
                {
                    finalSection.backgroundImage ? (
                        <img
                            src={finalSection.backgroundImage.src}
                            alt={finalSection.backgroundImage.alt}
                            width="1600"
                            height="900"
                            class="absolute inset-0 h-full w-full object-cover opacity-28"
                            loading="lazy"
                            decoding="async"
                        />
                    ) : null
                }
                <div
                    class="absolute inset-0 bg-[linear-gradient(135deg,rgba(17,32,20,0.92)_0%,rgba(36,67,41,0.82)_55%,rgba(27,50,30,0.96)_100%)]"
                >
                </div>
                <div
                    class="relative grid gap-8 p-8 sm:p-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:p-14"
                >
                    <div class="max-w-3xl">
                        {
                            finalSection.eyebrow ? (
                                <p
                                    class="text-sm font-semibold tracking-[0.18em] uppercase text-[var(--ccfg-sand)]"
                                >
                                    {finalSection.eyebrow}
                                </p>
                            ) : null
                        }
                        {
                            finalSection.heading ? (
                                <h2
                                    class="mt-3 text-4xl font-semibold text-balance lg:text-5xl"
                                >
                                    {finalSection.heading}
                                </h2>
                            ) : null
                        }
                        {
                            finalSection.body ? (
                                <p class="mt-5 text-lg leading-8 text-white/76">
                                    {finalSection.body}
                                </p>
                            ) : null
                        }
                    </div>
                    {
                        finalSection.primaryCta || finalSection.secondaryCta ? (
                            <div class="flex flex-col gap-4 sm:flex-row lg:flex-col">
                                {
                                    finalSection.primaryCta ? (
                                        <a
                                            href={finalSection.primaryCta.href}
                                            class="inline-flex items-center justify-center rounded-full bg-[var(--ccfg-cream)] px-7 py-4 text-sm font-semibold tracking-[0.12em] uppercase text-[var(--ccfg-forest)] transition hover:bg-white"
                                        >
                                            {finalSection.primaryCta.label}
                                        </a>
                                    ) : null
                                }
                                {
                                    finalSection.secondaryCta ? (
                                        <a
                                            href={finalSection.secondaryCta.href}
                                            class="inline-flex items-center justify-center rounded-full border border-white/25 px-7 py-4 text-sm font-semibold tracking-[0.12em] uppercase text-white transition hover:bg-white/10"
                                        >
                                            {finalSection.secondaryCta.label}
                                        </a>
                                    ) : null
                                }
                            </div>
                        ) : null
                    }
                </div>
            </div>
        </Container>
    </section>
        )
    }
</SiteLayout>
