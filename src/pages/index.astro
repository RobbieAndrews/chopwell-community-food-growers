---
import HomeFinalCta from "../components/home/HomeFinalCta.astro";
import HomeGallery from "../components/home/HomeGallery.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomePathways from "../components/home/HomePathways.astro";
import HomeSeasonal from "../components/home/HomeSeasonal.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getHomePageData } from "../lib/homePage";

const {
    heroSection,
    pathwaysSection,
    seasonalSection,
    gallerySection,
    finalSection,
} = await getHomePageData();
---

<SiteLayout title="Home" mainClass="px-0 py-0" wrapContent={false}>
    {heroSection && <HomeHero section={heroSection} />}
    {pathwaysSection && <HomePathways section={pathwaysSection} />}
    {seasonalSection && <HomeSeasonal section={seasonalSection} />}
    {gallerySection && <HomeGallery section={gallerySection} />}
    {finalSection && <HomeFinalCta section={finalSection} />}
</SiteLayout>
