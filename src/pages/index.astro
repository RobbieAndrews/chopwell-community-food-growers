---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';
import FullBleedSection from '../components/FullBleedSection.astro';
import {
	ArrowRight,
	CalendarDays,
	Leaf,
	MapPin,
	Sprout,
	Users,
} from '@lucide/astro';

const stats = [
	{ value: '150+', label: 'local members growing together' },
	{ value: '12', label: 'shared plots and community spaces' },
	{ value: '40+', label: 'hands-on events across the year' },
] as const;

const pathways = [
	{
		title: 'Community allotments',
		description: 'Shared plots, practical support, and plenty of room to learn by doing.',
		href: '/projects',
		linkLabel: 'Explore projects',
		image:
			'https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?auto=format&fit=crop&w=1200&q=80',
		icon: Sprout,
	},
	{
		title: 'Seasonal gatherings',
		description: 'Workshops, garden sessions, and celebrations that make the group feel alive.',
		href: '/calendar',
		linkLabel: 'See the calendar',
		image:
			'https://images.unsplash.com/photo-1523741543316-beb7fc7023d8?auto=format&fit=crop&w=1200&q=80',
		icon: CalendarDays,
	},
	{
		title: 'Shared knowledge',
		description: 'Growing guides, seasonal tips, and practical vegetable advice you can use at home.',
		href: '/growing-guides',
		linkLabel: 'Browse growing guides',
		image:
			'https://images.unsplash.com/photo-1516253593875-bd7ba052fbc5?auto=format&fit=crop&w=1200&q=80',
		icon: Leaf,
	},
] as const;

const seasonalMoments = [
	{
		title: 'Early season planting',
		copy: 'Seed sowing, plot prep, and the excitement of the first green shoots.',
	},
	{
		title: 'Summer growing days',
		copy: 'Long afternoons packed with practical work, conversation, and shared harvests.',
	},
	{
		title: 'Autumn skills and cooking',
		copy: 'Preserving, sharing recipes, and making the most of what the season gives us.',
	},
] as const;

const galleryItems = [
	{
		title: 'Fresh harvests',
		src: 'https://images.unsplash.com/photo-1461354464878-ad92f492a5a0?auto=format&fit=crop&w=1200&q=80',
		alt: 'Freshly harvested vegetables in wooden crates',
		heightClass: 'md:row-span-2 md:min-h-[32rem]',
	},
	{
		title: 'Shared moments',
		src: 'https://images.unsplash.com/photo-1464226184884-fa280b87c399?auto=format&fit=crop&w=1200&q=80',
		alt: 'People gardening together outdoors',
		heightClass: 'md:min-h-[15rem]',
	},
	{
		title: 'Beautiful spaces',
		src: 'https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?auto=format&fit=crop&w=1200&q=80',
		alt: 'Green growing beds in a community garden',
		heightClass: 'md:min-h-[15rem]',
	},
	{
		title: 'Food from the plot',
		src: 'https://images.unsplash.com/photo-1501004318641-b39e6451bec6?auto=format&fit=crop&w=1200&q=80',
		alt: 'Hands holding a basket of produce',
		heightClass: 'md:col-span-2 md:min-h-[18rem]',
	},
] as const;
---

<SiteLayout title="Home" mainClass="px-0 py-0" wrapContent={false}>
	<div class="bg-[var(--ccfg-cream)] text-[var(--ccfg-ink)]">
		<section class="relative isolate overflow-hidden bg-[linear-gradient(135deg,#19301d_0%,#26472a_48%,#c7b89a_100%)] text-white">
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.18),transparent_30%),radial-gradient(circle_at_bottom_right,rgba(244,213,141,0.22),transparent_24%)]"></div>
			<Container class="relative py-16 lg:py-24">
				<div class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-center">
					<div class="space-y-8">
						<div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold tracking-[0.18em] uppercase backdrop-blur">
							<MapPin class="h-4 w-4" />
							<span>Chopwell, Gateshead</span>
						</div>

						<div class="space-y-5">
							<h1 class="max-w-3xl text-5xl leading-[0.92] font-semibold text-balance sm:text-6xl lg:text-7xl">
								A greener, warmer community hub built around growing.
							</h1>
							<p class="max-w-2xl text-lg leading-8 text-white/78 sm:text-xl">
								Chopwell Community Food Growers brings people together through shared
								allotments, practical learning, and the simple pleasure of food grown
								close to home.
							</p>
						</div>

						<div class="flex flex-col gap-4 sm:flex-row">
							<a
								href="/get-involved"
								class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--ccfg-cream)] px-7 py-4 text-sm font-semibold tracking-[0.12em] uppercase text-[var(--ccfg-forest)] transition hover:-translate-y-0.5 hover:bg-white"
							>
								<span>Get involved</span>
								<ArrowRight class="h-4 w-4" />
							</a>
							<a
								href="/projects"
								class="inline-flex items-center justify-center rounded-full border border-white/28 px-7 py-4 text-sm font-semibold tracking-[0.12em] uppercase text-white transition hover:bg-white/10"
							>
								View projects
							</a>
						</div>

						<div class="grid gap-4 border-t border-white/15 pt-8 sm:grid-cols-3">
							{
								stats.map((item) => (
									<div class="rounded-3xl border border-white/10 bg-white/8 p-5 backdrop-blur-sm">
										<div class="text-3xl font-extrabold tracking-tight">{item.value}</div>
										<div class="mt-2 text-sm leading-6 text-white/72">{item.label}</div>
									</div>
								))
							}
						</div>
					</div>

					<div class="relative min-h-[32rem] lg:min-h-[42rem]">
						<div class="absolute inset-x-8 top-0 h-20 rounded-full bg-white/12 blur-3xl"></div>
						<div class="grid h-full gap-4 sm:grid-cols-[1.15fr_0.85fr] sm:grid-rows-[1.2fr_0.8fr]">
							<div class="overflow-hidden rounded-[2rem] shadow-2xl sm:row-span-2">
								<img
									src="https://images.unsplash.com/photo-1464226184884-fa280b87c399?auto=format&fit=crop&w=1400&q=80"
									alt="Members working together in a thriving community garden"
									width="1400"
									height="1600"
									class="h-full w-full object-cover"
									loading="eager"
									decoding="async"
								/>
							</div>
							<div class="overflow-hidden rounded-[1.75rem] shadow-2xl">
								<img
									src="https://images.unsplash.com/photo-1471193945509-9ad0617afabf?auto=format&fit=crop&w=1200&q=80"
									alt="Fresh vegetables laid out after harvest"
									width="1200"
									height="900"
									class="h-full w-full object-cover"
									loading="eager"
									decoding="async"
								/>
							</div>
							<div class="relative overflow-hidden rounded-[1.75rem] bg-[rgba(246,244,235,0.92)] p-6 text-[var(--ccfg-ink)] shadow-2xl">
								<div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-full bg-[var(--ccfg-forest)] text-white">
									<Users class="h-5 w-5" />
								</div>
								<p class="text-sm font-semibold tracking-[0.16em] uppercase text-[var(--ccfg-moss)]">
									What it feels like
								</p>
								<p class="mt-3 text-lg leading-7 text-gray-700">
									More than a garden, it is a place to learn new skills, meet people,
									and make something tangible together.
								</p>
							</div>
						</div>
					</div>
				</div>
			</Container>
		</section>

		<FullBleedSection class="py-20 lg:py-24" bleedClass="bleed-white-70">
			<div class="mb-10 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
				<div class="max-w-2xl">
					<p class="text-sm font-semibold tracking-[0.18em] uppercase text-[var(--ccfg-moss)]">
						What you can step into
					</p>
					<h2 class="mt-3 text-4xl font-semibold text-balance text-[var(--ccfg-ink)] lg:text-5xl">
						A homepage that feels active, welcoming, and full of life.
					</h2>
				</div>
				<p class="max-w-xl text-lg leading-8 text-gray-600">
					Instead of flat feature cards, these pathways use photography and stronger contrast
					to make the group feel real before someone ever clicks through.
				</p>
			</div>

			<div class="grid gap-6 lg:grid-cols-3">
				{
					pathways.map((item) => {
						const Icon = item.icon;

						return (
							<a
								href={item.href}
								class="group relative isolate flex min-h-[26rem] overflow-hidden rounded-[2rem] text-white shadow-xl"
							>
								<img
									src={item.image}
									alt={item.title}
									width="1200"
									height="1400"
									class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
									loading="lazy"
									decoding="async"
								/>
								<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(12,22,13,0.12)_0%,rgba(12,22,13,0.72)_65%,rgba(12,22,13,0.92)_100%)]"></div>
								<div class="relative flex w-full flex-col justify-between p-7">
									<div class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-white/25 bg-white/10 backdrop-blur-sm">
										<Icon class="h-5 w-5" />
									</div>
									<div>
										<h3 class="text-3xl font-semibold">{item.title}</h3>
										<p class="mt-3 max-w-sm text-base leading-7 text-white/78">
											{item.description}
										</p>
										<span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold tracking-[0.14em] uppercase text-[var(--ccfg-sand)]">
											{item.linkLabel}
											<ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
										</span>
									</div>
								</div>
							</a>
						);
					})
				}
			</div>
		</FullBleedSection>

		<section class="py-20 lg:py-24">
			<Container>
				<div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
					<div class="relative overflow-hidden rounded-[2.25rem] bg-[#d8ccb4] shadow-2xl">
						<img
							src="https://images.unsplash.com/photo-1591857177580-dc82b9ac4e1e?auto=format&fit=crop&w=1600&q=80"
							alt="Volunteers planting seedlings together"
							width="1600"
							height="1200"
							class="h-full min-h-[30rem] w-full object-cover"
							loading="lazy"
							decoding="async"
						/>
						<div class="absolute inset-x-6 bottom-6 rounded-[1.75rem] bg-[rgba(246,244,235,0.92)] p-5 text-[var(--ccfg-ink)] shadow-lg backdrop-blur">
							<p class="text-sm font-semibold tracking-[0.15em] uppercase text-[var(--ccfg-moss)]">
								Community-led and hands-on
							</p>
							<p class="mt-2 text-base leading-7 text-gray-700">
								The strongest part of the group is that people learn by being in it,
								rather than watching from the sidelines.
							</p>
						</div>
					</div>

					<div class="rounded-[2.25rem] bg-white/80 p-8 shadow-xl ring-1 ring-black/5 backdrop-blur lg:p-10">
						<p class="text-sm font-semibold tracking-[0.18em] uppercase text-[var(--ccfg-moss)]">
							The rhythm of the year
						</p>
						<h2 class="mt-3 text-4xl font-semibold text-balance text-[var(--ccfg-ink)] lg:text-5xl">
							A more editorial section that gives the homepage some identity.
						</h2>
						<p class="mt-5 max-w-2xl text-lg leading-8 text-gray-600">
							This block breaks up the page with a calmer layout: one strong image, one
							clear story, and a sense of seasonal progression rather than another row of
							generic cards.
						</p>

						<div class="mt-10 space-y-5">
							{
								seasonalMoments.map((item, index) => (
									<div class="grid gap-3 border-t border-[var(--ccfg-sand)]/70 pt-5 sm:grid-cols-[auto_1fr]">
										<div class="text-sm font-semibold tracking-[0.16em] uppercase text-[var(--ccfg-moss)]">
											0{index + 1}
										</div>
										<div>
											<h3 class="text-2xl font-semibold text-[var(--ccfg-ink)]">
												{item.title}
											</h3>
											<p class="mt-2 text-base leading-7 text-gray-600">{item.copy}</p>
										</div>
									</div>
								))
							}
						</div>

						<div class="mt-10 flex flex-col gap-4 sm:flex-row">
							<a
								href="/calendar"
								class="inline-flex items-center justify-center rounded-full bg-[var(--ccfg-forest)] px-6 py-3.5 text-sm font-semibold tracking-[0.12em] uppercase text-white transition hover:bg-[#1b331e]"
							>
								See upcoming events
							</a>
							<a
								href="/contact"
								class="inline-flex items-center justify-center rounded-full border border-[var(--ccfg-forest)]/18 px-6 py-3.5 text-sm font-semibold tracking-[0.12em] uppercase text-[var(--ccfg-forest)] transition hover:bg-[var(--ccfg-cream)]"
							>
								Contact the group
							</a>
						</div>
					</div>
				</div>
			</Container>
		</section>

		<FullBleedSection class="py-20 lg:py-24" bleedClass="bleed-gray-50">
			<div class="mb-10 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
				<div class="max-w-2xl">
					<p class="text-sm font-semibold tracking-[0.18em] uppercase text-[var(--ccfg-moss)]">
						Life in the gardens
					</p>
					<h2 class="mt-3 text-4xl font-semibold text-balance text-[var(--ccfg-ink)] lg:text-5xl">
						More imagery, but used with purpose.
					</h2>
				</div>
				<p class="max-w-xl text-lg leading-8 text-gray-600">
					The client wants pictures, so this gallery turns them into a proper storytelling
					device rather than decorative filler.
				</p>
			</div>

			<div class="grid auto-rows-fr gap-5 md:grid-cols-3">
				{
					galleryItems.map((item) => (
						<div
							class:list={[
								'group relative overflow-hidden rounded-[2rem] shadow-lg',
								item.heightClass,
							]}
						>
							<img
								src={item.src}
								alt={item.alt}
								width="1200"
								height="1200"
								class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
								loading="lazy"
								decoding="async"
							/>
							<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(10,18,11,0.04)_0%,rgba(10,18,11,0.7)_100%)]"></div>
							<div class="absolute inset-x-0 bottom-0 p-6 text-white">
								<p class="text-sm font-semibold tracking-[0.14em] uppercase text-[var(--ccfg-sand)]">
									Chopwell Community Food Growers
								</p>
								<h3 class="mt-2 text-2xl font-semibold">{item.title}</h3>
							</div>
						</div>
					))
				}
			</div>
		</FullBleedSection>

		<section class="py-20 lg:py-24">
			<Container>
				<div class="relative isolate overflow-hidden rounded-[2.5rem] bg-[#1d3520] text-white shadow-2xl">
					<img
						src="https://images.unsplash.com/photo-1516253593875-bd7ba052fbc5?auto=format&fit=crop&w=1600&q=80"
						alt="Table full of fresh produce and flowers"
						width="1600"
						height="900"
						class="absolute inset-0 h-full w-full object-cover opacity-28"
						loading="lazy"
						decoding="async"
					/>
					<div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(17,32,20,0.92)_0%,rgba(36,67,41,0.82)_55%,rgba(27,50,30,0.96)_100%)]"></div>
					<div class="relative grid gap-8 p-8 sm:p-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:p-14">
						<div class="max-w-3xl">
							<p class="text-sm font-semibold tracking-[0.18em] uppercase text-[var(--ccfg-sand)]">
								Ready to join in?
							</p>
							<h2 class="mt-3 text-4xl font-semibold text-balance lg:text-5xl">
								Make the homepage feel like the community is already in motion.
							</h2>
							<p class="mt-5 text-lg leading-8 text-white/76">
								If you want, I can carry the same visual direction through the other key
								pages next so the site feels consistently modern instead of just having
								one standout homepage.
							</p>
						</div>
						<div class="flex flex-col gap-4 sm:flex-row lg:flex-col">
							<a
								href="/get-involved"
								class="inline-flex items-center justify-center rounded-full bg-[var(--ccfg-cream)] px-7 py-4 text-sm font-semibold tracking-[0.12em] uppercase text-[var(--ccfg-forest)] transition hover:bg-white"
							>
								Start here
							</a>
							<a
								href="/contact"
								class="inline-flex items-center justify-center rounded-full border border-white/25 px-7 py-4 text-sm font-semibold tracking-[0.12em] uppercase text-white transition hover:bg-white/10"
							>
								Contact us
							</a>
						</div>
					</div>
				</div>
			</Container>
		</section>
	</div>
</SiteLayout>
