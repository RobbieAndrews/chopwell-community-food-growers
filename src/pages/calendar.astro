---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContentSection from '../components/ContentSection.astro';
import CalendarWidget from '../components/calendar/CalendarWidget';
import { sanityClient } from 'sanity:client';
import type { CalendarEvent } from '../components/calendar/types';
import { CALENDAR_EVENTS_QUERY } from '../data/calendar';

const calendarEvents = await sanityClient.fetch<CalendarEvent[]>(CALENDAR_EVENTS_QUERY);
---

<SiteLayout title="Calendar">
    <ContentSection spacing="tight" innerClass="">
        <CalendarWidget client:load events={calendarEvents} />
    </ContentSection>
</SiteLayout>
