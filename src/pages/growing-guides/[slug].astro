---
import {Bug, CalendarRange, Clock3, Droplets, Leaf, SunMedium, TextSearch} from '@lucide/astro';
import {PortableText} from 'astro-portabletext';
import {sanityClient} from 'sanity:client';

import BackLink from '../../components/BackLink.astro';
import ContentSection from '../../components/ContentSection.astro';
import SanityImage from '../../components/SanityImage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  articlePortableTextComponents,
} from '../../lib/articlePortableText';
import {
  getGrowingGuideCategoryTitle,
  getGrowingGuideDifficultyTitle,
  getGrowingGuideSeasonTitle,
  growingGuideFactLabels,
  type GrowingGuidePage,
} from '../../lib/growingGuides';
import {
} from '../../lib/sanity';

export async function getStaticPaths(): Promise<{params: {slug: string}}[]> {
  const GROWING_GUIDE_SLUGS_QUERY = `*[
    _type == "growingGuide"
    && defined(slug.current)
  ]{
    "params": { "slug": slug.current }
  }`;

  return await sanityClient.fetch(GROWING_GUIDE_SLUGS_QUERY);
}

const GROWING_GUIDE_QUERY = `*[
  _type == "growingGuide"
  && slug.current == $slug
][0]{
  _id,
  title,
  slug,
  excerpt,
  category,
  seasons,
  difficulty,
  keywords,
  heroImage,
  quickFacts,
  steps,
  commonProblems,
  body
}`;

const guide = await sanityClient.fetch<GrowingGuidePage | null>(GROWING_GUIDE_QUERY, {
  slug: Astro.params.slug,
});

if (!guide) {
  return Astro.redirect('/growing-guides');
}

const quickFactsEntries = Object.entries(guide.quickFacts ?? {}).filter(([, value]) => Boolean(value));
const categoryLabel = getGrowingGuideCategoryTitle(guide.category);
const difficultyLabel = guide.difficulty ? getGrowingGuideDifficultyTitle(guide.difficulty) : null;
const seasonLabels = guide.seasons.map((season) => getGrowingGuideSeasonTitle(season));
---

<SiteLayout title={guide.title}>
  <ContentSection size="narrow" spacing="stack" class="bg-white/70" innerClass="section-stack">
    <BackLink href="/growing-guides" label="Back to growing guides" />

    <section>
      <div class="flex flex-col justify-center pb-2 sm:pb-4">
        <div class="flex flex-wrap gap-2">
          <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold tracking-[0.12em] uppercase text-green-800">
            {categoryLabel}
          </span>
          {
            difficultyLabel ? (
              <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold tracking-[0.12em] uppercase text-amber-900">
                {difficultyLabel}
              </span>
            ) : null
          }
          {
            seasonLabels.map((season) => (
              <span class="rounded-full bg-[var(--ccfg-cream)] px-3 py-1 text-xs font-semibold tracking-[0.12em] uppercase text-[var(--ccfg-forest)]">
                {season}
              </span>
            ))
          }
        </div>

        <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
          {guide.title}
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-gray-600">{guide.excerpt}</p>
      </div>

      <div class="w-full">
        {
          guide.heroImage ? (
            <SanityImage
              image={guide.heroImage}
              alt={guide.heroImage.alt || guide.title}
              preset="contentHero"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-1280/822 h-full min-h-72 w-full object-cover max-h-96"
            />
          ) : (
            <div class="flex h-full min-h-72 items-center justify-center bg-linear-to-br from-lime-100 via-stone-50 to-emerald-100 text-green-900">
              <Leaf class="h-16 w-16" />
            </div>
          )
        }
      </div>

      <article class="my-3 border-t border-gray-200/80 py-3 sm:my-5 sm:py-5">
        {
          quickFactsEntries.length ? (
            <section class="mt-2 sm:rounded-[1.75rem] sm:bg-[var(--ccfg-cream)]/85 sm:p-6">
              <div class="flex items-center gap-3 text-[var(--ccfg-forest)]">
                <CalendarRange class="h-6 w-6" />
                <h2 class="text-2xl font-semibold text-gray-900">At a glance</h2>
              </div>

              <div class="mt-5 sm:grid sm:grid-cols-2 sm:gap-3">
                {
                  quickFactsEntries.map(([key, value]) => {
                    const factKey = key as keyof typeof growingGuideFactLabels;
                    const label = growingGuideFactLabels[factKey];
                    const Icon =
                      key === 'sun'
                        ? SunMedium
                        : key === 'watering'
                          ? Droplets
                          : key === 'harvest'
                            ? Clock3
                            : TextSearch;

                    return (
                      <div class="border-t border-black/10 py-4 first:border-t-0 sm:rounded-3xl sm:border-t-0 sm:bg-white sm:px-4 sm:py-4 sm:shadow-sm sm:ring-1 sm:ring-black/5">
                        <div class="flex items-start gap-3">
                          <div class="mt-0.5 flex h-10 w-10 items-center justify-center rounded-2xl bg-green-100 text-green-900">
                            <Icon class="h-5 w-5" />
                          </div>
                          <div>
                            <p class="text-sm font-semibold tracking-[0.12em] uppercase text-[var(--ccfg-moss)]">
                              {label}
                            </p>
                            <p class="mt-2 text-base leading-7 text-gray-700">{value}</p>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            </section>
          ) : null
        }

        {
          guide.steps?.length ? (
            <section class="mt-8">
              <div class="flex items-center gap-3 text-[var(--ccfg-forest)]">
                <Leaf class="h-6 w-6" />
                <h2 class="text-2xl font-semibold text-gray-900">How to grow it</h2>
              </div>

              <div class="mt-5">
                {
                  guide.steps.map((step, index) => (
                    <div class="border-t border-black/10 py-5 first:border-t-0 sm:py-6">
                      <div class="grid gap-3">
                        <div class="flex items-center gap-3">
                          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-green-100 text-sm font-bold text-green-900">
                            {index + 1}
                          </div>
                          <h3 class="text-xl font-semibold text-gray-900">{step.title}</h3>
                        </div>
                        <div>
                          <p class="text-base leading-7 text-gray-600">{step.description}</p>
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </section>
          ) : null
        }

        {
          guide.commonProblems?.length ? (
            <section class="mt-10 rounded-[1.75rem] bg-amber-50/75 p-5 sm:mt-12 sm:p-6">
              <div class="flex items-center gap-3 text-[var(--ccfg-forest)]">
                <Bug class="h-6 w-6" />
                <h2 class="text-2xl font-semibold text-gray-900">Common problems</h2>
              </div>

              <div class="mt-5">
                {
                  guide.commonProblems.map((item) => (
                    <section class="border-t border-amber-900/10 py-6 first:border-t-0 sm:py-7">
                      <h3 class="text-xl font-semibold text-gray-900">{item.problem}</h3>
                      <p class="mt-2 text-base leading-7 text-gray-700">{item.solution}</p>
                    </section>
                  ))
                }
              </div>
            </section>
          ) : null
        }

      </article>
    </section>
  </ContentSection>

  {
    Array.isArray(guide.body) && guide.body.length ? (
      <ContentSection size="narrow" spacing="stack" innerClass="section-stack">
        <section>
          <h2 class="text-2xl font-semibold text-gray-900">More growing advice</h2>
          <div class="mt-5">
            <PortableText value={guide.body} components={articlePortableTextComponents} />
          </div>
        </section>
      </ContentSection>
    ) : null
  }
</SiteLayout>
