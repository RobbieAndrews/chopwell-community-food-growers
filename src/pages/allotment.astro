---
import SiteLayout from '../layouts/SiteLayout.astro';
import FullBleedSection from '../components/FullBleedSection.astro';
import PageIntro from '../components/PageIntro.astro';
import { Calendar, Leaf, Shovel, Sprout, Users } from '@lucide/astro';
import { projects } from '../data/projects';

const project =
	projects.find((entry) => entry.slug === 'community-allotment') ?? projects[0];

const thisMonthPlans = [
	{
		title: 'Prepare and plant new beds',
		description:
			'We are clearing, feeding, and planting the main shared beds so they are ready for spring growth.',
		icon: Shovel,
	},
	{
		title: 'Keep seedlings moving',
		description:
			'Young plants need watering, checking, and potting on so they stay healthy before going outside.',
		icon: Sprout,
	},
	{
		title: 'Welcome more helping hands',
		description:
			'We are making space for new volunteers to join work sessions, learn the site, and take on small tasks.',
		icon: Users,
	},
] as const;

const currentWork = [
	'Refreshing paths, edges, and shared growing areas after winter.',
	'Planning what can be planted now and what needs a little more time under cover.',
	'Organising regular jobs so volunteers can easily drop in and help.',
	'Keeping an eye on what is thriving already and what needs extra attention.',
] as const;

const waysToHelp = [
	'Join a work day and help with planting, weeding, watering, or tidying.',
	'Bring gloves, sturdy shoes, and weather-ready layers for outdoor sessions.',
	'Get in touch if you want to help regularly or learn more before visiting.',
] as const;
---

<SiteLayout title="Community Allotment">
	<div class="space-y-8">
		<PageIntro
			title="Community Allotment"
			description="See what is happening at the allotment this month, what the group is working on now, and how people can get involved in the shared growing space."
			pills={[
				{ label: 'Shared growing space', icon: Leaf, iconClass: 'text-green-700' },
				{ label: 'Monthly updates', icon: Calendar, iconClass: 'text-amber-700' },
				{ label: 'Open to local volunteers', icon: Users, iconClass: 'text-sky-700' },
			]}
		/>

		<section class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
			<div class="space-y-6">
				<p class="max-w-2xl text-lg leading-8 text-gray-600">{project.intro}</p>
				<p class="text-base leading-7 text-gray-700">{project.details[0]}</p>

				<div class="flex flex-wrap gap-3">
					{project.highlights.map((highlight) => (
						<span class="rounded-full bg-green-100 px-4 py-2 text-sm font-semibold text-green-900">
							{highlight}
						</span>
					))}
				</div>
			</div>

			<div class="overflow-hidden rounded-[2rem] shadow-xl ring-1 ring-gray-100">
				<img
					src={project.imageUrl}
					alt={project.title}
					loading="eager"
					fetchpriority="high"
					decoding="async"
					width="1280"
					height="822"
					class="aspect-1280/822 h-full min-h-72 w-full object-cover max-h-96"
				/>
			</div>
		</section>

		<FullBleedSection class="mt-8 py-12" bleedClass="bleed-white-70">
			<section class="space-y-6">
				<div class="flex items-center gap-3">
					<div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-700">
						<Calendar class="h-6 w-6" />
					</div>
					<div>
						<p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-700">
							Plans for this month
						</p>
						<h2 class="text-3xl font-bold tracking-tight text-gray-900">
							What we are focusing on right now
						</h2>
					</div>
				</div>

				<div class="grid gap-5 md:grid-cols-3">
					{
						thisMonthPlans.map((plan) => {
							const PlanIcon = plan.icon;

							return (
								<article class="rounded-[2rem] bg-white p-6 shadow-xl ring-1 ring-gray-100">
									<div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-green-100 text-green-900">
										<PlanIcon class="h-6 w-6" />
									</div>
									<h3 class="mt-4 text-xl font-bold tracking-tight text-gray-900">
										{plan.title}
									</h3>
									<p class="mt-3 text-base leading-7 text-gray-600">{plan.description}</p>
								</article>
							);
						})
					}
				</div>
			</section>
		</FullBleedSection>

		<section class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
			<article class="rounded-4xl bg-white p-6 shadow-xl ring-1 ring-gray-100 sm:p-8">
				<div class="flex items-center gap-3">
					<div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
						<Leaf class="h-6 w-6" />
					</div>
					<h2 class="text-2xl font-bold tracking-tight text-gray-900">
						What we are working on now
					</h2>
				</div>

				<ul class="mt-6 space-y-4">
					{
						currentWork.map((item) => (
							<li class="flex gap-3">
								<span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-[#2d5016]"></span>
								<p class="text-base leading-7 text-gray-700">{item}</p>
							</li>
						))
					}
				</ul>
			</article>

			<aside class="rounded-4xl bg-[#2d5016] p-6 text-white shadow-2xl sm:p-8">
				<h2 class="text-2xl font-bold tracking-tight">Want to lend a hand?</h2>
				<p class="mt-3 leading-8 text-green-50">
					The allotment works best when people can join in at whatever level feels manageable,
					whether that is a one-off visit or regular help across the season.
				</p>

				<ul class="mt-6 space-y-4">
					{
						waysToHelp.map((item) => (
							<li class="flex gap-3">
								<span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-white"></span>
								<p class="leading-7 text-green-50">{item}</p>
							</li>
						))
					}
				</ul>

				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href="/contact"
						class="inline-flex items-center justify-center rounded-full bg-white px-5 py-3 font-semibold text-[#2d5016] transition hover:bg-green-50"
					>
						Contact us
					</a>
					<a
						href="/calendar"
						class="inline-flex items-center justify-center rounded-full border border-white/30 px-5 py-3 font-semibold text-white transition hover:bg-white/10"
					>
						Check the calendar
					</a>
				</div>
			</aside>
		</section>
	</div>
</SiteLayout>
