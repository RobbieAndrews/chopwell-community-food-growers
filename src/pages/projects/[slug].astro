---
import SiteLayout from '../../layouts/SiteLayout.astro';
import BackLink from '../../components/BackLink.astro';
import ContentSection from '../../components/ContentSection.astro';
import SanityImage from '../../components/SanityImage.astro';
import { PortableText } from 'astro-portabletext';
import { sanityClient } from 'sanity:client';
import ContentFeatureCard from '../../components/ContentFeatureCard.astro';
import {
	articlePortableTextComponents,
	type ArticlePortableTextBlock,
} from '../../lib/articlePortableText';
import {
	type SanityImageWithAlt,
} from '../../lib/sanity';

interface ProjectPage {
	_id: string;
	title: string;
	slug: { current: string };
	headline: string;
	mainImage?: SanityImageWithAlt;
	body?: ArticlePortableTextBlock[];
}

export async function getStaticPaths(): Promise<{ params: { slug: string } }[]> {
	const PROJECT_SLUGS_QUERY = `*[
		_type == "project"
		&& defined(slug.current)
	]{
		"params": { "slug": slug.current }
	}`;

	return await sanityClient.fetch(PROJECT_SLUGS_QUERY);
}

const PROJECT_QUERY = `*[
	_type == "project"
	&& slug.current == $slug
][0]{
	_id,
	title,
	slug,
	headline,
	mainImage,
	body
}`;

const project = await sanityClient.fetch<ProjectPage | null>(PROJECT_QUERY, {
	slug: Astro.params.slug,
});

if (!project) {
	return Astro.redirect('/projects');
}
---

<SiteLayout title={project.title}>
	<ContentSection size="narrow" spacing="stack" innerClass="section-stack">
		<BackLink href="/projects" label="Back to projects" />

		<ContentFeatureCard articleTitle="About this project">
			<Fragment slot="intro">
				<h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
					{project.title}
				</h1>

				<p class="mt-6 max-w-2xl text-lg leading-8 text-gray-600">{project.headline}</p>
			</Fragment>

			<Fragment slot="media">
				{
					project.mainImage ? (
						<SanityImage
							image={project.mainImage}
							alt={project.mainImage.alt || project.title}
							preset="contentHero"
							loading="eager"
							fetchpriority="high"
							decoding="async"
							class="aspect-1280/822 h-full min-h-72 w-full object-cover max-h-96"
						/>
					) : (
						<div class="flex h-full min-h-72 items-center justify-center bg-linear-to-br from-lime-100 via-stone-50 to-emerald-100 px-6 text-center text-base font-medium text-green-900">
							Project image coming soon
						</div>
					)
				}
			</Fragment>

			{
				Array.isArray(project.body) && project.body.length && (
					<div class="mt-5">
						<PortableText value={project.body} components={articlePortableTextComponents} />
					</div>
				)
			}
		</ContentFeatureCard>
	</ContentSection>
</SiteLayout>
