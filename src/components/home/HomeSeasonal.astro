---
import ButtonLink from "../ButtonLink.astro";
import Container from "../Container.astro";
import HomeSectionHeader from "./HomeSectionHeader.astro";
import type { HomeSeasonalSection } from "../../lib/homePage";

interface Props {
    section: HomeSeasonalSection;
}

const { section } = Astro.props as Props;
---

<section class="py-20 lg:py-24">
    <Container>
        <div
            class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]"
        >
            <div
                class="relative overflow-hidden rounded-[2.25rem] bg-[#d8ccb4] shadow-2xl"
            >
                {
                    section.featureImage ? (
                        <img
                            src={section.featureImage.src}
                            alt={section.featureImage.alt}
                            width="1600"
                            height="1200"
                            class="h-full min-h-[30rem] w-full object-cover"
                            loading="lazy"
                            decoding="async"
                        />
                    ) : (
                        <div class="min-h-[30rem] bg-[linear-gradient(135deg,#d8ccb4_0%,#efe6d5_100%)]" />
                    )
                }
                {
                    section.calloutLabel || section.calloutCopy ? (
                        <div
                            class="absolute inset-x-6 bottom-6 rounded-[1.75rem] bg-[rgba(246,244,235,0.92)] p-5 text-[var(--ccfg-ink)] shadow-lg backdrop-blur"
                        >
                            {
                                section.calloutLabel ? (
                                    <p
                                        class="text-sm font-semibold tracking-[0.15em] uppercase text-[var(--ccfg-moss)]"
                                    >
                                        {section.calloutLabel}
                                    </p>
                                ) : null
                            }
                            {
                                section.calloutCopy ? (
                                    <p class="mt-2 text-base leading-7 text-gray-700">
                                        {section.calloutCopy}
                                    </p>
                                ) : null
                            }
                        </div>
                    ) : null
                }
            </div>

            <div
                class="rounded-[2.25rem] bg-white/80 p-8 shadow-xl ring-1 ring-black/5 backdrop-blur lg:p-10"
            >
                <HomeSectionHeader
                    eyebrow={section.eyebrow}
                    heading={section.heading}
                    copy={section.intro}
                    layout="stacked"
                    class="mb-0"
                    copyClass="max-w-2xl text-lg leading-8 text-gray-600"
                />

                {
                    section.moments.length ? (
                        <div class="mt-10 space-y-5">
                            {
                                section.moments.map((item, index) => (
                                    <div class="grid gap-3 border-t border-[var(--ccfg-sand)]/70 pt-5 sm:grid-cols-[auto_1fr]">
                                        <div class="text-sm font-semibold tracking-[0.16em] uppercase text-[var(--ccfg-moss)]">
                                            {String(index + 1).padStart(2, "0")}
                                        </div>
                                        <div>
                                            <h3 class="text-2xl font-semibold text-[var(--ccfg-ink)]">
                                                {item.title}
                                            </h3>
                                            <p class="mt-2 text-base leading-7 text-gray-600">
                                                {item.copy}
                                            </p>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    ) : null
                }

                {
                    section.primaryCta || section.secondaryCta ? (
                        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
                            {
                                section.primaryCta ? (
                                    <ButtonLink
                                        href={section.primaryCta.href}
                                        variant="primary-dark"
                                        class="px-6 py-3.5"
                                    >
                                        {section.primaryCta.label}
                                    </ButtonLink>
                                ) : null
                            }
                            {
                                section.secondaryCta ? (
                                    <ButtonLink
                                        href={section.secondaryCta.href}
                                        variant="secondary-light"
                                        class="px-6 py-3.5"
                                    >
                                        {section.secondaryCta.label}
                                    </ButtonLink>
                                ) : null
                            }
                        </div>
                    ) : null
                }
            </div>
        </div>
    </Container>
</section>
