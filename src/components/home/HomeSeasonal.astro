---
import ButtonLink from "../ButtonLink.astro";
import ContentSection from "../ContentSection.astro";
import SanityImage from "../SanityImage.astro";
import HomeSectionHeader from "./HomeSectionHeader.astro";
import type { HomeSeasonalSection } from "../../lib/homePage";

interface Props {
    section: HomeSeasonalSection;
}

const { section } = Astro.props as Props;
---

<ContentSection spacing="home" innerClass="">
    <div
        class="grid gap-8 lg:items-stretch lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]"
    >
        <div
            class="order-1 space-y-6 lg:order-1 lg:h-full"
        >
            <div class="relative overflow-hidden rounded-[2.25rem] bg-[#d8ccb4] shadow-xl lg:h-full lg:shadow-2xl">
                {
                    section.featureImage ? (
                        <SanityImage
                            image={section.featureImage}
                            alt={section.featureImage.alt || section.heading || ""}
                            preset="homeSeasonalFeature"
                            class="h-full min-h-[22rem] w-full object-cover sm:min-h-[26rem] lg:min-h-0"
                            loading="lazy"
                            decoding="async"
                        />
                    ) : (
                        <div class="min-h-[22rem] h-full bg-[linear-gradient(135deg,#d8ccb4_0%,#efe6d5_100%)] sm:min-h-[26rem] lg:min-h-0" />
                    )
                }
                {
                    section.calloutLabel || section.calloutCopy ? (
                        <div class="absolute inset-x-6 bottom-6 hidden rounded-[1.75rem] bg-[rgba(246,244,235,0.92)] p-5 text-[var(--ccfg-ink)] shadow-lg backdrop-blur lg:block">
                            {
                                section.calloutLabel ? (
                                    <p class="text-sm font-semibold tracking-[0.15em] uppercase text-[var(--ccfg-moss)]">
                                        {section.calloutLabel}
                                    </p>
                                ) : null
                            }
                            {
                                section.calloutCopy ? (
                                    <p class="mt-2 text-base leading-7 text-gray-700">
                                        {section.calloutCopy}
                                    </p>
                                ) : null
                            }
                        </div>
                    ) : null
                }
            </div>
            {
                section.calloutLabel || section.calloutCopy ? (
                    <div class="rounded-[1.75rem] bg-[rgba(246,244,235,0.92)] p-5 text-[var(--ccfg-ink)] shadow-lg ring-1 ring-black/5 backdrop-blur lg:hidden">
                        {
                            section.calloutLabel ? (
                                <p class="font-['Fraunces',Georgia,'Times_New_Roman',serif] text-xl leading-8 italic text-[var(--ccfg-forest)]">
                                    {section.calloutLabel}
                                </p>
                            ) : null
                        }
                        {
                            section.calloutCopy ? (
                                <p class="mt-3 text-base leading-7 text-gray-700">
                                    {section.calloutCopy}
                                </p>
                            ) : null
                        }
                    </div>
                ) : null
            }
        </div>

        <div
            class="order-2 px-1 lg:order-2 lg:flex lg:h-full lg:flex-col lg:rounded-[2.25rem] lg:bg-white/80 lg:p-10 lg:shadow-xl lg:ring-1 lg:ring-black/5 lg:backdrop-blur"
        >
            <HomeSectionHeader
                eyebrow={section.eyebrow}
                heading={section.heading}
                copy={section.intro}
                layout="stacked"
                class="mb-0"
                headingClass="mt-3 text-[2.6rem] leading-[1.02] font-semibold text-balance text-[var(--ccfg-ink)] sm:text-5xl lg:text-5xl"
                copyClass="max-w-2xl text-lg leading-8 text-gray-600"
            />

            {
                section.moments.length ? (
                    <div class="mt-8 space-y-4 lg:mt-10 lg:space-y-5">
                        {
                            section.moments.map((item, index) => (
                                <div class="grid gap-3 border-t border-[var(--ccfg-sand)]/70 pt-4 sm:grid-cols-[auto_1fr] lg:pt-5">
                                    <div class="text-sm font-semibold tracking-[0.16em] uppercase text-[var(--ccfg-moss)]">
                                        {String(index + 1).padStart(2, "0")}
                                    </div>
                                    <div>
                                        <h3 class="text-[1.7rem] font-semibold leading-tight text-[var(--ccfg-ink)] lg:text-2xl">
                                            {item.title}
                                        </h3>
                                        <p class="mt-2 text-base leading-7 text-gray-600">
                                            {item.copy}
                                        </p>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                ) : null
            }

            {
                section.primaryCta || section.secondaryCta ? (
                    <div class="mt-8 flex flex-col gap-4 sm:flex-row lg:mt-10">
                        {
                            section.primaryCta ? (
                                <ButtonLink
                                    href={section.primaryCta.href}
                                    variant="primary-dark"
                                    class="px-6 py-3.5"
                                >
                                    {section.primaryCta.label}
                                </ButtonLink>
                            ) : null
                        }
                        {
                            section.secondaryCta ? (
                                <ButtonLink
                                    href={section.secondaryCta.href}
                                    variant="secondary-light"
                                    class="px-6 py-3.5"
                                >
                                    {section.secondaryCta.label}
                                </ButtonLink>
                            ) : null
                        }
                    </div>
                ) : null
            }
        </div>
    </div>
</ContentSection>
