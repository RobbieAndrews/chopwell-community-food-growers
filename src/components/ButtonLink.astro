---
import { ArrowRight } from "@lucide/astro";

type ButtonVariant =
    | "primary-light"
    | "secondary-dark"
    | "primary-dark"
    | "secondary-light";

interface Props {
    href: string;
    variant: ButtonVariant;
    class?: string;
    showArrow?: boolean;
}

const {
    href,
    variant,
    class: className = "",
    showArrow = false,
} = Astro.props as Props;

const variantClasses: Record<ButtonVariant, string> = {
    "primary-light":
        "bg-[var(--ccfg-cream)] text-[var(--ccfg-forest)] hover:bg-white hover:-translate-y-0.5",
    "secondary-dark":
        "border border-white/28 text-white hover:bg-white/10",
    "primary-dark":
        "bg-[var(--ccfg-forest)] text-white hover:bg-[#1b331e]",
    "secondary-light":
        "border border-[var(--ccfg-forest)]/18 text-[var(--ccfg-forest)] hover:bg-[var(--ccfg-cream)]",
};
---

<a
    href={href}
    class:list={[
        "inline-flex items-center justify-center rounded-full px-7 py-4 text-sm font-semibold tracking-[0.12em] uppercase transition",
        showArrow ? "gap-2" : "",
        variantClasses[variant],
        className,
    ]}
>
    <slot />
    {showArrow && <ArrowRight class="h-4 w-4" />}
</a>
