---
interface Props {
	as?: keyof HTMLElementTagNameMap;
	size?: 'narrow' | 'default';
	class?: string;
}

const {
	as = 'div',
	size = 'default',
	class: className = '',
} = Astro.props as Props;

const As = as;

const sizeClasses = {
	narrow: 'mx-auto w-full max-w-4xl px-4 sm:px-6 lg:px-8',
	default: 'mx-auto w-full max-w-6xl px-3 sm:px-6 lg:px-8',
};
---

<As class:list={[sizeClasses[size], className]}>
	<slot />
</As>
